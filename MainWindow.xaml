<Window x:Class="Starbucks_POS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:viewModels="clr-namespace:Starbucks_POS.ViewModels"
        xmlns:models="clr-namespace:Starbucks_POS.Models"
        Title="POS Terminal" 
        WindowState="Maximized" 
        Background="#202020">
    
    <Window.Resources>
        
        
        <!-- Set Default variables for all buttons-->
        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property = "Padding" Value="0" />
        </Style>
        
        <!-- Set Default Variables for Drinks Buttons-->
        <Style x:Key="DrinkButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Width" Value="170"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        
        <!-- Set Default Variables for Limited Time Drinks Buttons-->
        <Style x:Key="LmtdDrinkButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Width" Value="170"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="Margin" Value="0,30,0,10"/>
        </Style>
        
        <!-- Set Default variables for Espresso Drinks Buttons-->
        <Style x:Key="EspressoDrinkButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Width" Value="170"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="Margin" Value="4,0,4,10"/>
        </Style>
        
        <!-- Set Default Variables for Limited Time Espresso Drinks Buttons-->
        <Style x:Key="LmtdEspressoDrinkButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Width" Value="170"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="Margin" Value="0,30,8,10"/>
        </Style>
        
        <!-- Set Format for Importing permanent Drinks from Database -->
        <DataTemplate DataType="{x:Type models:Drink}">
            <ui:Button Style="{StaticResource DrinkButton}" Background="{Binding HexCode}">
                <TextBlock TextAlignment="Center" Text="{Binding TextBlockName}" TextWrapping="Wrap"/>
            </ui:Button>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:LmtdDrink}">
            <ui:Button Style="{StaticResource LmtdDrinkButton}" Background="{Binding HexCode}">
                <TextBlock TextAlignment="Center" Text="{Binding TextBlockName}" TextWrapping="Wrap"/>
            </ui:Button>
        </DataTemplate>
        
        
        <!-- VARIABLE CONSTANTS -->
        <SolidColorBrush x:Key="BackgroundColour" Color="#202020"/>
    </Window.Resources>
    
    
    <!-- Attach the logic to the UI -->
    <Window.DataContext>
        <viewModels:CartViewModel/>
    </Window.DataContext>

    
<!--////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////-->
    
    <Viewbox Stretch="Uniform">
        <!-- BIG MAIN GRID -->
        <Grid Width="1920" Height="1080">
            
            <!-- Define The 3 Main Columns-->
            <Grid.ColumnDefinitions>
                
                <ColumnDefinition Width="440" /> <!-- 1st column for receipts -->
                <ColumnDefinition Width="*" />   <!-- 2nd column for the menu -->
                
            </Grid.ColumnDefinitions>
            
            
    <!--////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////-->
            
            
            <!-- RECEIPT COLUMN -->
            <Grid Grid.Column="0">
                
                <!-- Define the Grid -->
                <Grid.RowDefinitions>
                
                    <RowDefinition Height="120" /> <!-- 1st Row for Starbucks App -->
                    <RowDefinition Height="760" /> <!-- 2nd Row for Receipt list -->
                    <RowDefinition Height="*" /> <!-- 3rd Row for Buttons -->
                
                </Grid.RowDefinitions>
                
                <!-- Starbucks App -->
                <WrapPanel Grid.Row="0">
                
                    <ui:Button Content="⌕" Height="120" Width="100" Margin="0"
                               Background="#878787" BorderThickness="0" CornerRadius="0" FontSize="30">
                    </ui:Button>
                    
                    <ui:Button Height="120" Width="340" Margin="0 "
                               Background="#666666" BorderThickness="0" CornerRadius="0" 
                               HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Padding="10,15,0,0">
                        
                        <StackPanel>
                            <TextBlock Text="Scan Star-Coffee ID" FontSize="35" TextWrapping="Wrap"/>
                            <TextBlock Text="Ready" FontSize="20" Foreground="#AAAAAA" Margin="0,3,0,0"/>
                        </StackPanel>
                        
                    </ui:Button>
                
                </WrapPanel> 
                
                
    <!--////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////-->
                
                
                <!-- Receipts Panel -->  
                <StackPanel Grid.Row="1" Background="LightGray">
                    
                </StackPanel>
                
            
            
            
    <!--////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////-->
            
                
                <!-- Button Panel -->
                
                <WrapPanel Grid.Row="2" Background="#3b3b3b">
                     
                    <ui:Button Width = "190" Height="140" Margin="25,25,0,10">
                        <TextBlock TextAlignment="Center">
                            Functions
                        </TextBlock>
                    </ui:Button>
                    
                    <ui:Button Width = "190" Height="140" Margin="10,25,0,10">
                        <TextBlock TextAlignment="Center">
                            Reprint Customer<LineBreak/>Receipt
                        </TextBlock>
                    </ui:Button>
                    
                </WrapPanel>
                
            </Grid>
            
            
    <!--////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////-->
            
            
            <!-- SECOND COLUMN -->
            
            <!-- Put Grid in 3rd Column -->
            <Grid Grid.Column="1">
                
                <!-- Define the Grid -->
                <Grid.RowDefinitions>
                
                    <RowDefinition Height="120" /> <!-- 1st Row for Item Categories -->
                    <RowDefinition Height="60" /> <!-- 2nd Row for Size -->
                    <RowDefinition Height="60" /> <!-- 3rd Row for Drink Categories -->
                    <RowDefinition Height="*" /> <!-- 4th Row for Drinks -->
                
                </Grid.RowDefinitions>
                
                <Grid.ColumnDefinitions>
                    
                    <ColumnDefinition Width="200" />  <!-- 1st column for the customisation menu -->
                    <ColumnDefinition Width="*" />   <!-- 2nd column for the menu -->
                
                </Grid.ColumnDefinitions>
                
                
                <!-- Item Categories 1st Row  -->
                <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                    
                    <ui:Button DockPanel.Dock="Left" Content="⌕" Height="120" Width="170" Margin="0"
                               Background="#108533" BorderThickness="0" CornerRadius="0" FontSize="30"/>
        
                    <UniformGrid Rows="1">
                        <ui:Button Content="Drinks" HorizontalAlignment="Stretch" Height="120" Margin="0"
                                   Background="#108533" BorderThickness="0" CornerRadius="0"/>
                        <ui:Button Content="Bakery" HorizontalAlignment="Stretch" Height="120" Margin="0"
                                   Background="#108533" BorderThickness="0" CornerRadius="0"/>
                        <ui:Button Content="Chilled" HorizontalAlignment="Stretch" Height="120" Margin="0"
                                   Background="#108533" BorderThickness="0" CornerRadius="0"/>
                        <ui:Button Content="Impulse" HorizontalAlignment="Stretch" Height="120" Margin="0"
                                   Background="#108533" BorderThickness="0" CornerRadius="0"/>
                        <ui:Button Content="Lobby" HorizontalAlignment="Stretch" Height="120" Margin="0"
                                   Background="#108533" BorderThickness="0" CornerRadius="0"/>
                        <ui:Button Content="Gift Card" HorizontalAlignment="Stretch" Height="120" Margin="0"
                                   Background="#108533" BorderThickness="0" CornerRadius="0"/>
                    </UniformGrid>
        
                </DockPanel>
                
                
                <!-- Drink Sizes 2nd Row -->
                <UniformGrid Grid.Row="1" Grid.Column="1" Rows="1" Margin= "50,0,50,0">
                    
                    <ui:Button Content="Short" HorizontalAlignment="Stretch" Height="120" Margin="0,10,0,0"
                               Background="#666666" CornerRadius="10000, 0 ,0 ,10000"/>
                    <ui:Button Content="Tall" HorizontalAlignment="Stretch" Height="120" Margin="4,10,0,0"
                               Background="#666666"/>
                    <ui:Button Content="Grande" HorizontalAlignment="Stretch" Height="120" Margin="4,10,0,0"
                               Background="#666666"/>
                    <ui:Button Content="Venti" HorizontalAlignment="Stretch" Height="120" Margin="4,10,0,0"
                               Background="#666666" CornerRadius="0, 10000 ,10000 ,0"/>
                    
                    <ui:Button Content="Iced" HorizontalAlignment="Stretch" Height="120" Margin="10,10,10,0"
                               Background="#666666" CornerRadius="10000" />
                    
                    <ui:Button Content="Blond" HorizontalAlignment="Stretch" Height="120" Margin="0,10,4,0"
                               Background="#666666" CornerRadius="10000, 0 ,0 ,10000"/>
                    <ui:Button Content="Signature" HorizontalAlignment="Stretch" Height="120" Margin="4,10,0,0"
                               Background="#666666"/>
                    <ui:Button Content="Decaf" HorizontalAlignment="Stretch" Height="120" Margin="4,10,0,0"
                               Background="#666666" CornerRadius="0, 10000 ,10000 ,0"/>
                    
                </UniformGrid>
                
                
                <!-- Drink Categories 3rd Row -->
                <WrapPanel Grid.Row="2" Grid.Column="1" Margin="50,0,0,0" >
                    
                    <ui:Button Content="Espresso"  Height="120" Width="180" Margin="110,24,20,0" BorderThickness="0"   
                               Background="{StaticResource BackgroundColour}" />
                    <ui:Button Content="Frappuccino" Height="120" Width="180" Margin="89,24,20,0" BorderThickness="0"   
                               Background="{StaticResource BackgroundColour}"/>
                    <ui:Button Content="Brewed" Height="120" Width="180" Margin="0,24,20,0" BorderThickness="0"   
                               Background="{StaticResource BackgroundColour}"/>
                    <ui:Button Content="Tea" Height="120" Width="180" Margin="0,24,20,0" BorderThickness="0"   
                               Background="{StaticResource BackgroundColour}"/>
                    <ui:Button Content="Other" Height="120" Width="180" Margin="0,24,20,0" BorderThickness="0"   
                               Background="{StaticResource BackgroundColour}"/>
                    
                </WrapPanel>
                
                
    <!--////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////-->
                
                
                <!-- DRINKS 4th row-->
                
                <Grid Grid.Row="3" Grid.Column="1" >
                    
                    
                    <!-- Define Columns-->
                    <Grid.ColumnDefinitions>
                
                        <ColumnDefinition Width="426" /> <!-- 1st column for Espresso -->
                        <ColumnDefinition Width="199" /> <!-- 2nd column for Frappucchino -->
                        <ColumnDefinition Width="199" /> <!-- 3rd column for Brewed -->
                        <ColumnDefinition Width="199" /> <!-- 4th column for Tea -->
                        <ColumnDefinition Width="199" /> <!-- 5th column for Other -->
                
                    </Grid.ColumnDefinitions>
                    
                    <Grid.RowDefinitions>
                
                        <RowDefinition Height="670" /> <!-- 1st Row for Permanent Drinks -->
                        <RowDefinition Height="Auto" /> <!-- 2nd column for Limited Time Drinks -->
                
                    </Grid.RowDefinitions>
                    
                    
                    <!-- First Column Espresso -->
                    <ItemsControl Grid.Column="0" ItemsSource="{Binding PermanentEspressoDrinks}">
                        <ItemsControl.Resources>
                            
                            <!-- Defines the Espresso Buttons -->
                            <DataTemplate DataType="{x:Type models:Drink}">
                                <ui:Button Style="{StaticResource EspressoDrinkButton}" Background="{Binding HexCode}">
                                    <TextBlock TextAlignment="Center" Text="{Binding TextBlockName}" TextWrapping="Wrap"/>
                                </ui:Button>
                            </DataTemplate>
                            
                            <DataTemplate DataType="{x:Type models:LmtdDrink}">
                                <ui:Button Style="{StaticResource LmtdEspressoDrinkButton}" Background="{Binding HexCode}">
                                    <TextBlock TextAlignment="Center" Text="{Binding TextBlockName}" TextWrapping="Wrap"/>
                                </ui:Button>
                            </DataTemplate>
                            
                        </ItemsControl.Resources>
                        
                        
                        <!-- Places The Buttons -->
                        <ItemsControl.ItemsPanel>
                            
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Vertical" Margin="70,20,0,0"/>
                            </ItemsPanelTemplate>
                            
                        </ItemsControl.ItemsPanel>
                    </ItemsControl> 
                    
                    
    <!--////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////-->
                    
                    
                    <!-- Second Column Frappuccino -->
                    <ItemsControl Grid.Column="1" Grid.Row="0" ItemsSource="{Binding PermanentFrappuccinoDrinks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Vertical" Margin="30,20,0,0"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    
                    
    <!--////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////-->
                    
                    
                    <!-- Third Column Brewed -->
                    <ItemsControl Grid.Column="2" Grid.Row="0" ItemsSource="{Binding PermanentBrewedDrinks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Vertical" Margin="30,20,0,0"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    
                    
    <!--////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////-->
                    
                    
                    <!-- Fourth Column Tea -->
                    <ItemsControl Grid.Column="3" Grid.Row="0" ItemsSource="{Binding PermanentTeaDrinks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Vertical" Margin="30,20,0,0"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    
                    
    <!--////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////-->
                    
                    
                    <!-- Fifth Column Other -->
                    <ItemsControl Grid.Column="4" Grid.Row="0" ItemsSource="{Binding PermanentOtherDrinks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Vertical" Margin="30,20,0,0"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    
                    
<!--////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////-->
                    
                    
                    <!-- LIMITED TIME DRINKS ROW -->
                    
                    <!-- Espresso Drinks -->
                    <ItemsControl Grid.Column="0" Grid.Row="1" ItemsSource="{Binding LimitedEspressoDrinks}">
                        <ItemsControl.Resources>
                            
                            <DataTemplate DataType="{x:Type models:LmtdDrink}">
                                
                                <ui:Button Style="{StaticResource LmtdEspressoDrinkButton}" Background="{Binding HexCode}">
                                    <TextBlock TextAlignment="Center" Text="{Binding TextBlockName}" TextWrapping="Wrap"/>
                                </ui:Button>
                                
                            </DataTemplate>
                        </ItemsControl.Resources>
                        
                        <ItemsControl.ItemsPanel>
                            
                            <ItemsPanelTemplate>
                            
                                <WrapPanel Margin="70,0,0,0"/>
                                
                            </ItemsPanelTemplate>
                            
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    
                    
                    <!-- Frappuccino -->
                    <ItemsControl Grid.Column="1" Grid.Row="1" ItemsSource="{Binding LimitedFrappuccinoDrinks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Vertical" Margin="30,0,0,0"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    
                    
                    <!-- Brewed -->
                    <ItemsControl Grid.Column="2" Grid.Row="1" ItemsSource="{Binding LimitedBrewedDrinks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Vertical" Margin="30,0,0,0"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    
                    
                    <!-- Tea -->
                    <ItemsControl Grid.Column="3" Grid.Row="1" ItemsSource="{Binding LimitedTeaDrinks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Vertical" Margin="30,0,0,0"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    
                    
                    <!-- Other -->
                    <ItemsControl Grid.Column="4" Grid.Row="1" ItemsSource="{Binding LimitedOtherDrinks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Vertical" Margin="30,0,0,0"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    
                </Grid> <!-- End of drinks column -->
                
            </Grid>
        
        </Grid> 
    </Viewbox>    
</Window>